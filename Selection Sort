import java.util.*;

class SelectionSort {
        public void sortedArray(int[] a,int n){
                int min;
                for(int i=0;i<=n-2;i++){
                        min=i;
                        for(int j=i+1;j<=n-1;j++){
                                if(a[min]>a[j]){
                                        min=j;
                                }
                        }
                        int temp=a[min];
                        a[min]=a[i];
                        a[i]=temp;
                        System.out.print("\nPass " + (i+1) +": ");
                        for(int elt:a){
                                System.out.print(elt+"\t");
                        }
                }
        }
}

class SelectionSortPgm {
        public static void main(String[] args){
                int[] a;
                Scanner sc=new Scanner(System.in);
                System.out.println("Enter the no. of Elements:");
                int n=sc.nextInt();
                a=new int[n];
                for(int i=0;i<n;i++){
                        System.out.println("Enter the element "+(i+1)+":");
                        a[i]=sc.nextInt();
                }
                System.out.println("\nBefore Sorting :");
                for(int elt:a){
                        System.out.print(elt+"\t");
                }
                SelectionSort ss=new SelectionSort()    ;
                ss.sortedArray(a,n);
                System.out.println("\nAfter Sorting :");
                for(int elt:a){
                        System.out.print(elt+"\t");
                }
        }
}


