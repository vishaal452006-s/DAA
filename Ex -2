import java.util.*;
class StringSearchPgm {
        public static int search(String txt,String ptn){
                int t=txt.length();
                int p=ptn.length();
                System.out.println(txt);
                for(int i=0;i<=t-p;i++){
            int j=0;
                        for(int x=0;x<i;x++){
                                           System.out.print(" ");
                        }
                        while(j<p){
                                if(txt.charAt(i+j)==ptn.charAt(j)){

                                        System.out.print(ptn.charAt(j));
                                        j=j+1;
                                }
                                else if(txt.charAt(i+j)!=ptn.charAt(j)){
                                        System.out.print(ptn.charAt(j));
                                        System.out.println();
                                        break;
                                }
                        }
                        if(j==p){
                                return i;
                        }
                }
                return -1;
        }
        public static void main(String[] args){
                Scanner sc=new Scanner(System.in);
                System.out.println("Enter the Text:");
                String txt=sc.nextLine();
                System.out.println("Enter the pattern to find:");
                String ptn=sc.nextLine();
                int res=search(txt,ptn);
                if(res!=-1){
                        System.out.println();
                        System.out.println("Pattern Found at index "+res);
                }
                else if(res==-1){
                        System.out.println();
                        System.out.println("Pattern Not Found");
                }
        }
}


