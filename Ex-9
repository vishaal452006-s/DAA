Knapsack Branch and Bound
--------------------------
import java.util.*;

class Item {
    int weight, profit, index;
    double ratio;

    Item(int w, int p, int i) {
        weight = w;
        profit = p;
        index = i;
        ratio = (double) p / w;
    }
}

class Node {
    int level, profit, weight;
    double bound;
    List<Integer> taken;

    Node(int level, int profit, int weight, List<Integer> taken) {
        this.level = level;
        this.profit = profit;
        this.weight = weight;
        this.taken = new ArrayList<>(taken);
    }
}

public class KnapsackBranchBound {

    static int n, W;
    static Item[] items;
    static double bound(Node u) {
        if (u.weight >= W)
            return 0;

        double profitBound = u.profit;
        int j = u.level + 1;
        int totalWeight = u.weight;

        while (j < n && totalWeight + items[j].weight <= W) {
            totalWeight += items[j].weight;
            profitBound += items[j].profit;
            j++;
        }

        if (j < n) {
            profitBound = Math.ceil(profitBound+((W - totalWeight) * items[j].ratio));
        }

        return profitBound;
    }

    static void knapsack() {

        PriorityQueue<Node> pq = new PriorityQueue<>(
                (a, b) -> Double.compare(b.bound, a.bound)
        );

        Node u, v;

        u = new Node(-1, 0, 0, new ArrayList<>());
        u.bound = bound(u);
        pq.add(u);

        int maxProfit = 0;
        List<Integer> bestItems = new ArrayList<>();

        System.out.println("\n--- Step by Step Execution ---\n");

        while (!pq.isEmpty()) {
            u = pq.poll();
            System.out.println("----------------------------------------------------------");
            System.out.print("\nExpanding Node :\n Level= " + u.level +
                    "\nProfit= " + u.profit +
                    "\nWeight= " + u.weight);
            System.out.printf("\nBound=%.2f",u.bound);
            System.out.println("\n-----------------------------------------------------------");
            if (u.bound > maxProfit) {

                v = new Node(u.level + 1, u.profit, u.weight, u.taken);

                if (v.level < n) {
                    v.weight = u.weight + items[v.level].weight;
                    v.profit = u.profit + items[v.level].profit;
                    v.taken.add(items[v.level].index);
                    System.out.println("+++++++++++++++++++++++++++++++++++++++++++++++++++++");
                    System.out.println("With Item " + items[v.level].index);
                    System.out.println("Weight ="+ v.weight);
                    System.out.println("Profit ="+ v.profit);
                    System.out.println("+++++++++++++++++++++++++++++++++++++++++++++++++++++");
                    if (v.weight <= W && v.profit > maxProfit) {
                        maxProfit = v.profit;
                        bestItems = new ArrayList<>(v.taken);
                    }

                    v.bound = bound(v);

                    if (v.bound > maxProfit) {
                        pq.add(v);
                    }
                }

                v = new Node(u.level + 1, u.profit, u.weight, u.taken);

                if (v.level < n) {
                   System.out.println("++++++++++++++++++++++++++++++++++++++++++++++++++++++");
                    System.out.println("Without Item " + items[v.level].index);
                    System.out.println("Weight ="+ u.weight);
                    System.out.println("Profit ="+ u.profit);
                    System.out.println("+++++++++++++++++++++++++++++++++++++++++++++++++++++");
                    v.bound = bound(v);

                    if (v.bound > maxProfit) {
                        pq.add(v);
                    }
                }
            }
        }

        System.out.println("\n--- Final Result ---");
        System.out.println("Maximum Profit = " + maxProfit);
        System.out.println("Items Selected (original indices): " + bestItems);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of items: ");
        n = sc.nextInt();

        items = new Item[n];

        System.out.println("Enter weight and profit of each item:");
        for (int i = 0; i < n; i++) {
            System.out.println("Enter weight and profit of item:"+(i+1));
            int w = sc.nextInt();
            int p = sc.nextInt();
            items[i] = new Item(w, p, i + 1);
        }

        System.out.print("Enter capacity of knapsack: ");
        W = sc.nextInt();

        Arrays.sort(items, (a, b) -> Double.compare(b.ratio, a.ratio));

        knapsack();
    }
}

