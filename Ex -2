import java.util.*;

class Point {
        double x,y;
        public Point(double x,double y){
                this.x=x;
                this.y=y;
        }
}

class ClosestPair {
        public  double[] findClosestPair(Point[] p,int n) {
                double d=9999999;
                double x,y;
                double[] p1=new double[5];
                for(int i=0;i<=n-1;i++){
                        for(int j=i+1;j<=n-1;j++){
                                double res=(Math.pow((p[j].x-p[i].x),2)+Math.pow((p[j].y-p[i].y),2));
                                double result=Math.pow(res,0.5);
                                System.out.printf("Distance between the points ("+p[i].x+","+p[i].y+") and ("+p[j].x+","+p[j].y+") is  %2.4f",result);
                                System.out.println();
                                if(d>result){
                                        d=result;
                                        p1[0] = p[i].x;
                    p1[1] = p[i].y;
                    p1[2] = p[j].x;
                    p1[3] = p[j].y;
                    p1[4] = d;


                                }
                        }
                }
                return p1;
        }
}

class ClosestPairPgm {
        public static void main(String[] args){
                Scanner sc=new Scanner(System.in);
                System.out.println("Enter the no. of points:");
                int n=sc.nextInt();
                Point[] p=new Point[n];
                for(int i=0;i<n;i++){
                        System.out.println("Point "+(i+1)+":");
                        double x=sc.nextDouble();
                        double y=sc.nextDouble();
                        p[i]=new Point(x,y);
                }
                ClosestPair cp=new ClosestPair();
                double[] res=cp.findClosestPair(p,n);
                 System.out.printf(
            "Closest points are (" + res[0] + ", " + res[1] +
            ") and (" + res[2] + ", " + res[3] +
            ") with minimum distance  %2.4f",res[4]
        );
        }
}


