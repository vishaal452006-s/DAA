import java.util.*;

class HeapSort {
    public void HeapBottomUp(int[] arr, int n) {
        for (int i = n / 2; i >= 1; i--) {
            siftDown(arr, i, n);
        }
    }

        private void siftDown(int[] arr, int k, int n) {
        int v = arr[k];
        boolean heap = false;

        while (!heap && (2 * k <= n)) {
            int j = 2 * k;
            if (j < n) {
                if (arr[j] < arr[j + 1]) {
                    j = j + 1;
                }
            }

            if (v >= arr[j]) {
                heap = true;
            } else {
                arr[k] = arr[j];
                k = j;
            }
        }
        arr[k] = v;
    }

        public void sort(int[] arr, int n) {
        HeapBottomUp(arr, n);

        for (int i = n; i > 1; i--) {
            int temp = arr[1];
            arr[1] = arr[i];
            arr[i] = temp;
            siftDown(arr, 1, i - 1);
        }
    }
}

class HeapSortPgm {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the no. of Elements:");
        int n = sc.nextInt();

        HeapSort hs = new HeapSort();
        int[] arr = new int[n + 1];

        for (int i = 1; i <= n; i++) {
            System.out.print("Enter the element " + i + ": ");
            arr[i] = sc.nextInt();
        }

        System.out.print("Before Sorting: ");
        for (int i = 1; i <= n; i++) System.out.print(arr[i] + " ");
        System.out.println();

        hs.sort(arr, n);

        System.out.print("After Sorting: ");
        for (int i = 1; i <= n; i++) System.out.print(arr[i] + " ");
    }
}

