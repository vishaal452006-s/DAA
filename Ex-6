import java.util.*;
class FloydAlgorithm {
   public int[][] adjacency(int[][] mat,int size){
      int n=size;
      int[][] d=mat;
      for(int k=0;k<n;k++){
         for(int j=0;j<n;j++){
            for(int i=0;i<n;i++){
               int a=d[i][j];
               int b=d[i][k]+d[k][j];
               if(a<=b){
                  d[i][j]=a;
               }
               else{
                  d[i][j]=b;
               }
            }
         }
      }
      return d;
   }
   public static void main(String[] args){
      FloydAlgorithm fa=new FloydAlgorithm();
      Scanner sc=new Scanner(System.in);
      System.out.println("Enter the no. of vertices:");
      int size=sc.nextInt();
      int[][] mat=new int[size][size];
      for(int i=0;i<size;i++){
         for(int j=0;j<size;j++){
            if(i!=j){
               System.out.println("Enter the distance from vertex "+(i+1)+"to"+(j+1)+":");
               mat[i][j]=0;mat[i][j]=sc.nextInt();
            }
            else{
               mat[i][j]=0;
            }
         }
      }
      int[][] res=new int[size][size];
      res=fa.adjacency(mat,size);
      for(int i=0;i<size;i++){
         for(int j=0;j<size;j++){
            System.out.print(res[i][j]+" ");
         }
         System.out.println();
      }
      for(int i=0;i<size;i++){
         for(int j=0;j<size;j++){
            System.out.println("Shortest distance from vertex "+(i+1)+"to"+(j+1)+"is"+res[i][j]);
         }
      }
   }
}
